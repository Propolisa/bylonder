{
  "blender": "v5.2.3",
  "float32": true,
  "roots": [
    {
      "source": "source/blender/bmesh/tools/bmesh_bevel.cc",
      "functions": [
        "BM_mesh_bevel"
      ]
    },
    {
      "source": "source/blender/bmesh/intern/bmesh_opdefines.cc",
      "constants": [
        "bmo_triangulate_def",
        "bmo_join_triangles_def",
        "bmo_reverse_faces_def",
        "bmo_recalc_face_normals_def",
        "bmo_smooth_vert_def",
        "bmo_poke_def",
        "bmo_connect_vert_pair_def",
        "bmo_bridge_loops_def",
        "BMO_ERROR_CANCEL"
      ]
    }
  ],
  "modules": {
    "bmesh/bmesh.wasm": {
      "api": ["bmesh-api.cc", "operator-properties.cc", "editor-context.cc", "main-api.cc", "modifier-api.cc", "panel-layout.cc", "outliner-api.cc", "region-draw.cc"],
      "fetch": ["release/datafiles/userdef/userdef_default_theme.c"],
      "defines": ["WITH_OPENSUBDIV", "WITH_BULLET", "WITH_MOD_REMESH", "WITH_OPENVDB"],
      "includes": ["intern/opensubdiv", "intern/dualcon", "intern/rigidbody", "intern/openvdb", "extern/bullet2/src"],
      "operators": ["source/blender/editors/mesh/mesh_intern.hh", "source/blender/editors/object/object_transform.cc"],
      "dependencies": {
        "fmt": {"url": "https://github.com/fmtlib/fmt.git", "tag": "12.1.0", "include": "include"},
        "eigen": {"url": "https://gitlab.com/libeigen/eigen/-/archive/8a1083e9bf41b91fdea6546681f806154efdc25a/eigen-8a1083e9bf41b91fdea6546681f806154efdc25a.tar.gz",
                  "tag": "8a1083e9", "sha256": "cc28a84fdec496c6777596350ea805519bf10f717d21044ae6ba3dd562183a26"},
        "opensubdiv": {"url": "https://github.com/PixarAnimationStudios/OpenSubdiv.git", "tag": "v3_7_0"},
        "openvdb": {"url": "https://github.com/AcademySoftwareFoundation/openvdb.git", "tag": "v13.0.0", "include": "openvdb",
                    "configure": {"openvdb/openvdb/version.h": {"OpenVDB_MAJOR_VERSION": 13, "OpenVDB_MINOR_VERSION": 0, "OpenVDB_PATCH_VERSION": 0,
                                                                 "OPENVDB_ABI_VERSION_NUMBER": 13, "OPENVDB_PACKED_VERSION": 218103808}}}
      },
      "libraries": [
        "source/blender/editors/mesh",
        "source/blender/editors/util",
        "source/blender/editors/transform",
        "source/blender/editors/uvedit/uvedit_select.cc",
        "source/blender/editors/object/object_add.cc",
        "source/blender/editors/object/object_transform.cc",
        "source/blender/editors/object/object_utils.cc",
        "source/blender/editors/object/object_select.cc",
        "source/blender/editors/screen/screen_context.cc",
        "source/blender/editors/space_outliner",
        "source/blender/editors/space_outliner/tree",
        "source/blender/editors/interface/view2d/view2d.cc",
        "source/blender/editors/interface/resources.cc",
        "source/blender/editors/interface/interface_style.cc",
        "source/blender/editors/interface/interface_icons.cc",
        "source/blender/editors/interface/view2d/view2d_ops.cc",
        "source/blender/editors/interface/view2d/view2d_edge_pan.cc",
        "source/blender/windowmanager/intern/wm_event_query.cc",
        "source/blender/animrig/intern/keyframing.cc",
        "source/blender/animrig/intern/keyframing_auto.cc",
        "source/blender/animrig/intern/keyingsets.cc",
        "source/blender/bmesh/intern",
        "source/blender/bmesh/operators",
        "source/blender/bmesh/tools",
        {"path": "source/blender/blenkernel/intern", "exclude": ["blender.cc", "scene.cc", "constraint.cc", "shader_fx.cc", "action.cc"]},
        {"path": "source/blender/blenkernel/intern/constraint.cc", "includes": ["source/blender/ikplugin"]},
        {"path": "source/blender/blenkernel/intern/shader_fx.cc", "includes": ["source/blender/shader_fx"]},
        {"path": "source/blender/blenkernel/intern/action.cc", "includes": ["source/blender/ikplugin"]},
        {"path": "source/blender/modifiers/intern", "exclude": ["MOD_nodes.cc"]},
