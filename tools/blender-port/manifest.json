        "intern/opensubdiv/internal/topology",
        {"path": "intern/opensubdiv/internal/evaluator", "exclude": ["eval_output_gpu.cc", "gpu_compute_evaluator.cc", "gpu_patch_table.cc"]},
        {"dependency": "opensubdiv", "path": "opensubdiv/far"},
        {"dependency": "opensubdiv", "path": "opensubdiv/sdc"},
        {"dependency": "opensubdiv", "path": "opensubdiv/vtr"},
        {"dependency": "opensubdiv", "path": "opensubdiv/bfr"},
        {"dependency": "opensubdiv", "path": "opensubdiv/osd"},
        {"dependency": "openvdb", "path": "openvdb/openvdb"},
        {"dependency": "openvdb", "path": "openvdb/openvdb/io", "exclude": ["File.cc", "Queue.cc"]},
        {"dependency": "openvdb", "path": "openvdb/openvdb/math"},
        {"dependency": "openvdb", "path": "openvdb/openvdb/points"},
        {"dependency": "openvdb", "path": "openvdb/openvdb/util"},
        "source/blender/blentranslation/intern",
        "source/blender/functions/intern",
        "source/blender/nodes/intern/geometry_nodes_bundle.cc",
        "source/blender/windowmanager/intern/wm_operator_props.cc",
        "source/blender/makesdna/intern/dna_utils.cc",
        {"path": "source/blender/makesrna/intern", "exclude": ["rna_access.cc", "rna_access_compare_override.cc", "rna_define.cc", "rna_path.cc",
                                                               "makesrna.cc", "makesrna_utils.cc"]},
        "source/blender/blenlib/intern",
        "intern/guardedalloc/intern",
        "intern/clog",
        "intern/eigen/intern",
        "extern/wcwidth"
      ]
    }
  },
  "units": {
    "blenkernel/mesh/mesh-tessellate.js": {
      "api": {
        "corner_tris_calc": "source/blender/blenkernel/intern/mesh_tessellate.cc",
        "BLI_polyfill_calc": "source/blender/blenlib/intern/polyfill_2d.cc"
      },
      "sources": [
        "source/blender/blenlib/intern/BLI_heap.cc",
        "source/blender/blenlib/intern/BLI_memarena.cc",
        "source/blender/blenlib/intern/math_geom.cc",
        "source/blender/blenlib/intern/math_matrix_c.cc",
        "source/blender/blenlib/intern/math_vector.cc",
        "source/blender/blenlib/intern/polyfill_2d_beautify.cc",
        "source/blender/blenlib/intern/task_range.cc",
        "intern/guardedalloc/intern/leak_detector.cc",
        "intern/guardedalloc/intern/mallocn.cc",
        "intern/guardedalloc/intern/mallocn_lockfree_impl.cc",
        "intern/guardedalloc/intern/memory_usage.cc"
      ]
    }
  },
  "exclude_modules": {
    "blenkernel/": "Custom data layers, deform groups and custom normals are not in Bylonder's BMesh yet",
    "blenlib/memarena": "JS allocates with the garbage collector",
    "blenlib/time": "Debug timing",
    "blenlib/assert": "Debug checks"
  },
  "exclude": {
    "BM_lnorspace_update": "Harden Normals: custom split normals are not ported"
  }
}
