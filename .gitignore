# Dependencies
node_modules

# Build output
dist/
dist-ssr/
*.tsbuildinfo
.vite/

# Generated by scripts/source-archive.mjs during build
public/app-source.zip
# Fetched by scripts/babylon-assets.mjs during build and dev
public/webgpu/
public/babylon-assets/
public/bylonder-dev-tools/

# Local-only Sites hosting config and secrets
.openai/*.local.*
.env
.env.*
!.env.example

# Logs and caches
*.log
npm-debug.log*
.npm/
.eslintcache
/coverage/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.blender-reference/
# Dev tools (npm run tools): delete to remove them.
.tools/
.shots/
__pycache__/

# Agent worktrees and local Claude Code state.
.claude/
examples/**/*.blend1

# Blender's module: built by CI and fetched by npm run module (scripts/module.mjs), or built locally.
src/bmesh/bmesh.wasm
src/bmesh/bmesh.wasm.key
src/bmesh/python313.zip
src/bmesh/scripts.zip
src/bmesh/addons.zip

# Demo packages, fetched by scripts/module.mjs from the release demo-packages (docs/demos/packages.json)
docs/demos/*/world/
# A copy of docs/demos/run.js for a server whose root is one demo folder (the playtest servers)
docs/demos/*/run.js
