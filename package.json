    "@babylonjs/inspector": "8.32.0",
    "@babylonjs/loaders": "8.32.0",
    "@babylonjs/materials": "8.32.0",
    "@babylonjs/node-editor": "8.32.0",
    "@babylonjs/node-geometry-editor": "8.32.0",
